# Copy to .env.local (gitignored) and fill in to turn on accounts and sync.
# Both values are in the Supabase dashboard: Project Settings → API.
# They're public by design and end up in the built app; row-level security
# (supabase/migrations/0001_accounts_sync.sql) is what protects the data.
# Leave them unset and SplitSnap stays local-only, with no account screens.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
